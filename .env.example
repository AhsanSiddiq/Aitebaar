# Copy to .env and fill in. Never commit .env.
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# Optional until step 3 (AI extraction). App degrades to manual entry without it.
ANTHROPIC_API_KEY=""
# PSX data: "seed" (offline, fictional demo symbols) or "dps" (live PSX data portal).
# Live PSX data is PSX's property; get a data licence before commercial use (CLAUDE.md §17).
PSX_DATA_SOURCE="seed"
# PSX_BASE_URL="https://dps.psx.com.pk"
